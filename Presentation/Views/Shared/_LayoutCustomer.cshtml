<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ITLA Banking</title>
    
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/styles/components/layout-customer.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
    <script src="https://unpkg.com/phosphor-icons"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<body>

    <div class="app-wrapper">
        <!-- SIDEBAR -->
        <aside class="sidebar shadow-sm">
            <div class="sidebar-header">
                <a class="brand-name" asp-controller="Customer" asp-action="Index"> PANEL CLIENTES
                </a>
            </div>

            <nav class="sidebar-nav">
                <ul class="nav-list">
                    <li>
                        <a class="nav-link-custom" asp-controller="Customer" asp-action="Index">
                            <i class="ph-bold ph-house-line"></i> Home
                        </a>
                    </li>
                    <li>
                        <a class="nav-link-custom" asp-controller="TransactionCustomer" asp-action="Transaction">
                            <i class="ph-bold ph-arrows-left-right"></i> Transacciones
                        </a>
                    </li>
                    <li>
                        <a class="nav-link-custom" asp-controller="Beneficiary" asp-action="Index">
                            <i class="ph-bold ph-users-three"></i> Beneficiarios
                        </a>
                    </li>
                    <li>
                        <a class="nav-link-custom" asp-controller="InternalTransfer" asp-action="Index">
                            <i class="ph-bold ph-swap"></i> Transferencias
                        </a>
                    </li>
                    <li>
                        <a class="nav-link-custom" asp-controller="CashAdvance" asp-action="Index">
                            <i class="ph-bold ph-money"></i> Avances
                        </a>
                    </li>
                </ul>
            </nav>

            <div class="sidebar-footer">
                <div class="mb-2 px-3" style="font-size: 11px; color: #888;">
                    <i class="ph-bold ph-user me-1"></i> @User.Identity?.Name
                </div>
                <a class="logout-link" asp-controller="Login" asp-action="Logout">
                    <i class="ph-bold ph-sign-out me-2"></i> Cerrar sesión
                </a>
            </div>
        </aside>

        <!-- CONTENIDO PRINCIPAL -->
        <main class="main-content">
            <div class="container-fluid">
                @RenderBody()
            </div>
            
            <footer class="mt-5 text-muted small py-3 border-top">
                &copy; @DateTime.Now.Year - Eric Pineda | Yohansel Mieses
            </footer>
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>