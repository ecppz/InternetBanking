<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Internet Banking</title>
    
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/styles/components/layout-admin.css" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap" rel="stylesheet">
    <!-- Phosphor Icons -->
    <script src="https://unpkg.com/@@phosphor-icons/web@2.1.1"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<body>

    <div class="app-wrapper">
        <aside class="sidebar shadow-sm">
            <div class="sidebar-header">
                <a class="brand-name" asp-controller="Admin" asp-action="Index">PANEL ADMIN
                </a>
            </div>

            <nav class="sidebar-nav">
                <ul class="nav-list">
                    <small class="nav-label">Monitoreo</small>
                    <li>
                        <a class="nav-link-custom" asp-controller="Admin" asp-action="Index">
                            <i class="ph-bold ph-chart-pie-slice"></i> Dashboard
                        </a>
                    </li>

                    <small class="nav-label">Mantenimientos</small>
                    <li>
                        <a class="nav-link-custom" asp-controller="MaintenanceUser" asp-action="Index">
                            <i class="ph-bold ph-users-four"></i> Usuarios
                        </a>
                    </li>
                    <li>
                        <a class="nav-link-custom" asp-controller="SavingsAccount" asp-action="List">
                            <i class="ph-bold ph-wallet"></i> Cuentas de Ahorro
                        </a>
                    </li>
                    <li>
                        <a class="nav-link-custom" asp-controller="Loan" asp-action="Index">
                            <i class="ph-bold ph-hand-coins"></i> Préstamos
                        </a>
                    </li>
                    <li>
                        <a class="nav-link-custom" asp-controller="CreditCard" asp-action="Index">
                            <i class="ph-bold ph-credit-card"></i> Tarjetas de Crédito
                        </a>
                    </li>
                </ul>
            </nav>

            <div class="sidebar-footer">
                <div class="user-info px-3 mb-2">
                    <i class="ph-bold ph-user-circle me-1"></i> @User.Identity?.Name
                </div>
                <a class="logout-link" asp-controller="Login" asp-action="Logout">
                    <i class="ph-bold ph-power me-2"></i> Cerrar Sesión
                </a>
            </div>
        </aside>

        <main class="main-content">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>