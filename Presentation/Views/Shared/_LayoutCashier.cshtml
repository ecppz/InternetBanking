<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Internet Banking</title>
    
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
    
    <script src="https://unpkg.com/@@phosphor-icons/web@2.1.1"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    
    <link rel="stylesheet" href="~/styles/components/layout-cashier.css" asp-append-version="true" />
</head>
<body>

    <div class="app-wrapper">
        <!-- SIDEBAR VERTICAL DEL CAJERO -->
        <aside class="sidebar shadow-sm">
            <div class="sidebar-header">
                <a class="brand-name" asp-controller="Cashier" asp-action="Index">PANEL CAJERO
                </a>
            </div>

            <nav class="sidebar-nav">
                <ul class="nav-list">
                    <small class="nav-label">General</small>
                    <li>
                        <a class="nav-link-custom" asp-controller="Cashier" asp-action="Index">
                            <i class="ph-bold ph-house"></i> Home
                        </a>
                    </li>

                    <small class="nav-label">Operaciones de Caja</small>
                    <li>
                        <a class="nav-link-custom text-success-hover" asp-controller="Transaction" asp-action="Deposit">
                            <i class="ph-bold ph-hand-deposit"></i> Depósito
                        </a>
                    </li>
                    <li>
                        <a class="nav-link-custom text-danger-hover" asp-controller="Transaction" asp-action="Withdrawal">
                            <i class="ph-bold ph-hand-withdraw"></i> Retiro
                        </a>
                    </li>

                    <small class="nav-label">Pagos y Otros</small>
                    <li>
                        <a class="nav-link-custom" asp-controller="CreditCardPayment" asp-action="Index">
                            <i class="ph-bold ph-credit-card"></i> Pago Tarjeta
                        </a>
                    </li>
                    <li>
                        <a class="nav-link-custom" asp-controller="LoanPayment" asp-action="Index">
                            <i class="ph-bold ph-bank"></i> Pago Préstamo
                        </a>
                    </li>
                    <li>
                        <a class="nav-link-custom" asp-controller="Transaction" asp-action="TransferToThirdParty">
                            <i class="ph-bold ph-arrows-left-right"></i> Transf. Terceros
                        </a>
                    </li>
                </ul>
            </nav>

            <div class="sidebar-footer">
                <div class="user-info px-3 mb-2">
                    <i class="ph-bold ph-user-circle me-1"></i> @User.Identity?.Name
                </div>
                <a class="logout-link" asp-controller="Login" asp-action="Logout">
                    <i class="ph-bold ph-sign-out me-2"></i> Cerrar sesión
                </a>
            </div>
        </aside>

        <!-- CONTENIDO PRINCIPAL -->
        <main class="main-content">
            <div class="container-fluid">
                @RenderBody()
                @await Html.PartialAsync("_Alerts")
            </div>
            
            <footer class="mt-5 text-muted small py-3 border-top text-center">
                &copy; @DateTime.Now.Year - Eric Pineda | Yohansel Mieses - ITLA Internet Banking
            </footer>
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>