@using Domain.Common.Enums

@{
    ViewData["Title"] = "Access denied";
    Layout = "_LayoutAnonymous";

    string Role = "";

    if (!string.IsNullOrWhiteSpace(ViewBag.CurrentRol))
    {
        if (ViewBag.CurrentRol == Roles.Admin.ToString())
        {
            Layout = "_LayoutAdmin";
            Role = "Admin";
        }
        else if (ViewBag.CurrentRol == Roles.Cashier.ToString())
        {
            Layout = "_LayoutCashier";
            Role = "Cashier";
        }
        else if (ViewBag.CurrentRol == Roles.Customer.ToString())
        {
            Layout = "_LayoutCustomer";
            Role = "Customer";
        }
    }
}

<div class="text-center">
    <h1 class="display-4">Access denied</h1>
    <p>
        No tienes permisos para acceder a esta sección —
        <a asp-controller="@Role" asp-action="Index">
            <i class="bi bi-house-door"></i> Home
        </a>
    </p>
</div>
