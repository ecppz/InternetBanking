@model LoginViewModel

@{
    ViewData["Title"] = "Inicio de sesión";
    Layout = "_LayoutAnonymous";
}

<div class="d-flex justify-content-center mt-5">
    <div class="col-12 col-md-5">
        <div class="card shadow">
            <div class="card-header bg-primary text-white text-center">
                <h5><i class="bi bi-person-circle"></i> Iniciar sesión</h5>
            </div>
            <div class="card-body">
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger text-center">
                        @TempData["Error"]
                    </div>
                }

                @Html.ValidationSummary(false, "", new { @class = "text-danger" })

                <form asp-controller="Login" asp-action="Index" method="post">
                    <div class="mb-3">
                        <label asp-for="UserName" class="form-label">Usuario</label>
                        <input asp-for="UserName" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label asp-for="Password" class="form-label">Contraseña</label>
                        <input asp-for="Password" class="form-control" type="password" />
                    </div>

                    <div class="d-flex justify-content-end">
                        <button type="submit" class="btn btn-outline-success me-2">
                            <i class="bi bi-door-open"></i> Entrar
                        </button>

                        <a asp-action="ForgotPassword" class="btn btn-outline-warning">
                            <i class="bi bi-question-circle"></i> ¿Olvidaste tu clave?
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>