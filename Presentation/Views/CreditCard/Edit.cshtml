@model EditCreditCardViewModel
@{
    ViewData["Title"] = "Editar límite de tarjeta";
    Layout = "_LayoutAdmin";
}

<div class="col-12 col-md-6 offset-md-3">
    <div class="card">
        <div class="card-header bg-warning text-dark">
            <h5 class="text-center">Editar límite de crédito</h5>
        </div>
        <div class="card-body">
            <form asp-controller="CreditCard" asp-action="Edit" method="POST">
                <input type="hidden" asp-for="CardId" />

                <div class="mb-3">
                    <label asp-for="NewLimit" class="form-label">Nuevo límite de crédito:</label>
                    <input class="form-control" asp-for="NewLimit" type="number" min="0" step="0.01" />
                    <span asp-validation-for="NewLimit" class="text-danger"></span>
                </div>

                <div class="mt-4">
                    <button type="submit" class="btn btn-outline-warning float-end">
                        <i class="bi bi-pencil-square"></i> Actualizar
                    </button>
                    <a asp-controller="CreditCard" asp-action="Index" class="btn btn-outline-secondary float-end me-2">
                        <i class="bi bi-arrow-left-short"></i> Cancelar
                    </a>
                </div>
            </form>
        </div>
    </div>

</div>
