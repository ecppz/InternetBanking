@model CreateLoanViewModel
@{
    ViewData["Title"] = "Asignación de préstamo";
    Layout = "_LayoutAdmin";
}

<div class="col-12 col-md-8 offset-md-2">
    <div class="card">
        <div class="card-header bg-primary text-light">
            <h5 class="text-center">"Asignando nuevo préstamo"</h5>
        </div>
        <div class="card-body">
            <form asp-controller="Loan" asp-action="Create" method="POST">
                <input type="hidden" asp-for="Id" />

                <div class="mb-3">
                    <label asp-for="UserId" class="form-label">Cliente:</label>
                    <input class="form-control" asp-for="UserId" />
                    <span asp-validation-for="UserId" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Amount" class="form-label">Monto a prestar:</label>
                    <input class="form-control" asp-for="Amount" />
                    <span asp-validation-for="Amount" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="TermMonths" class="form-label">Plazo (meses):</label>
                    <select asp-for="TermMonths" class="form-select">
                        @for (int i = 6; i <= 60; i += 6)
                        {
                            <option value="@i">@i meses</option>
                        }
                    </select>
                    <span asp-validation-for="TermMonths" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="AnnualInterestRate" class="form-label">Tasa de interés anual (%):</label>
                    <input class="form-control" asp-for="AnnualInterestRate" />
                    <span asp-validation-for="AnnualInterestRate" class="text-danger"></span>
                </div>

                <div class="mt-4">
                    <button type="submit" class="btn btn-outline-primary float-end">
                        <i class="bi bi-floppy2"></i> Guardar
                    </button>
                    <a asp-controller="Loan" asp-action="Index" class="btn btn-outline-secondary float-end me-2">
                        <i class="bi bi-arrow-left-short"></i> Cancelar
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>
