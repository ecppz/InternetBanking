@model EditLoanViewModel
@{
    ViewData["Title"] = "Editar tasa de préstamo";
    Layout = "_LayoutAdmin";
}

<div class="col-12 col-md-6 offset-md-3">
    <div class="card">
        <div class="card-header bg-warning text-dark">
            <h5 class="text-center">Editar tasa de interés</h5>
        </div>
        <div class="card-body">
            <form asp-controller="Loan" asp-action="Edit" method="POST">
                <input type="hidden" asp-for="Id" />

                <div class="mb-3">
                    <label asp-for="AnnualInterestRate" class="form-label">Tasa de interés anual (%):</label>
                    <input class="form-control" asp-for="AnnualInterestRate" />
                    <span asp-validation-for="AnnualInterestRate" class="text-danger"></span>
                </div>

                <div class="mt-4">
                    <button type="submit" class="btn btn-outline-warning float-end">
                        <i class="bi bi-pencil-square"></i> Actualizar
                    </button>
                    <a asp-controller="Loan" asp-action="Index" class="btn btn-outline-secondary float-end me-2">
                        <i class="bi bi-arrow-left-short"></i> Cancelar
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>
