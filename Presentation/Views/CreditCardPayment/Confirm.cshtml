@model CreditCardPaymentConfirmationViewModel

@{
    ViewData["Title"] = "Confirmación de Pago a Tarjeta";
    Layout = "_LayoutCashier";
}

<h2 class="mb-4">
    <i class="bi bi-credit-card-2-front text-primary"></i> Confirmación de Pago a Tarjeta
</h2>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger d-flex align-items-center">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        @TempData["ErrorMessage"]
    </div>
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success d-flex align-items-center">
        <i class="bi bi-check-circle-fill me-2"></i>
        @TempData["SuccessMessage"]
    </div>
}

<div asp-validation-summary="All" class="text-danger mb-3"></div>

<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-primary text-white">
        <i class="bi bi-info-circle"></i> Detalles del Pago
    </div>

    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-4"><i class="bi bi-credit-card text-primary"></i> Tarjeta</dt>
            <dd class="col-sm-8">****@Model.CreditCardNumber.Substring(Model.CreditCardNumber.Length - 4)</dd>

            <dt class="col-sm-4"><i class="bi bi-bank text-primary"></i> Cuenta Origen</dt>
            <dd class="col-sm-8">****@Model.OriginAccountNumber.Substring(Model.OriginAccountNumber.Length - 4)</dd>

            <dt class="col-sm-4"><i class="bi bi-person-vcard text-primary"></i> Titular</dt>
            <dd class="col-sm-8">@Model.HolderName @Model.HolderLastName</dd>

            <dt class="col-sm-4"><i class="bi bi-currency-exchange text-primary"></i> Deuda antes del pago</dt>
            <dd class="col-sm-8">@Model.DebtBeforePayment.ToString("C")</dd>

            <dt class="col-sm-4"><i class="bi bi-wallet2 text-primary"></i> Monto a Pagar</dt>
            <dd class="col-sm-8">@Model.PaymentAmount.ToString("C")</dd>

            <dt class="col-sm-4"><i class="bi bi-calendar-event text-primary"></i> Fecha de Transacción</dt>
            <dd class="col-sm-8">@Model.TransactionDate.ToString("dd/MM/yyyy HH:mm")</dd>
        </dl>
    </div>
</div>

<form asp-action="Confirm" method="post">
    <input type="hidden" asp-for="CreditCardId" />
    <input type="hidden" asp-for="UserId" />
    <input type="hidden" asp-for="OriginAccountId" />
    <input type="hidden" asp-for="HolderName" />
    <input type="hidden" asp-for="HolderLastName" />
    <input type="hidden" asp-for="CreditCardNumber" />
    <input type="hidden" asp-for="OriginAccountNumber" />
    <input type="hidden" asp-for="PaymentAmount" />
    <input type="hidden" asp-for="TransactionDate" />

    <button type="submit" class="btn btn-primary">
        <i class="bi bi-check-circle"></i> Confirmar Pago
    </button>
    <a asp-action="Index" class="btn btn-secondary ms-2">
        <i class="bi bi-x-circle"></i> Cancelar
    </a>
</form>
