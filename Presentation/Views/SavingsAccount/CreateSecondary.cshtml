@model CreateSavingsAccountViewModel

@{
    Layout = "_LayoutAdmin";
}

<h2><i class="fas fa-plus-circle"></i> Crear Cuenta Secundaria</h2>

<form asp-action="CreateSecondary" method="post">
    <input type="hidden" asp-for="UserId" />
    <input type="hidden" asp-for="IsPrimary" value="false" />

    <div class="form-group">
        <label asp-for="InitialBalance"><i class="fas fa-money-bill-wave"></i> Balance Inicial</label>
        <input asp-for="InitialBalance" class="form-control" />
        <span asp-validation-for="InitialBalance" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-success">
        <i class="fas fa-check-circle"></i> Crear Cuenta
    </button>
    <a asp-action="List" class="btn btn-secondary">
        <i class="fas fa-arrow-left"></i> Volver al listado
    </a>
</form>