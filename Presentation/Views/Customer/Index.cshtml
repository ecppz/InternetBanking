@using Domain.Common.Enums
@model CustomerHomeViewModel
@{
    Layout = "_LayoutCustomer";
    ViewData["Title"] = "Home del Cliente";
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger d-flex align-items-center">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        @TempData["ErrorMessage"]
    </div>
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success d-flex align-items-center">
        <i class="bi bi-check-circle-fill me-2"></i>
        @TempData["SuccessMessage"]
    </div>
}

<h2 class="mb-4 d-flex align-items-center">
    <i class="bi bi-wallet2 text-primary me-2 fs-3"></i>
    Mis Cuentas de Ahorro
</h2>

<div class="row row-cols-1 row-cols-md-2 g-4">
    @foreach (var account in Model.Accounts)
    {
        <div class="col">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h5 class="card-title d-flex align-items-center">
                        <i class="bi bi-bank text-success me-2 fs-4"></i>
                        Cuenta @account.AccountNumber
                    </h5>
                    <p class="card-text mb-1">
                        <i class="bi bi-cash-stack me-1 text-secondary"></i>
                        Balance: <strong>@account.Balance.ToString("C")</strong>
                    </p>
                    <p class="card-text">
                        <i class="bi bi-star-fill me-1 @(account.IsPrimary ? "text-warning" : "text-muted")"></i>
                        Tipo: @(account.IsPrimary ? "Principal" : "Secundaria")
                    </p>
                    <a asp-action="AccountDetails" asp-route-accountId="@account.Id" class="btn btn-outline-primary btn-sm">
                        <i class="bi bi-eye-fill me-1"></i> Ver detalles
                    </a>
                </div>
            </div>
        </div>
    }
</div>

<hr class="my-4" />

<h2 class="mb-4 d-flex align-items-center">
    <i class="bi bi-cash-stack text-success me-2 fs-3"></i>
    Mi Préstamo Activo
</h2>

@if (Model.Loan != null)
{
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <h5 class="card-title">Préstamo @Model.Loan.LoanNumber</h5>
            <p>Monto: <strong>@Model.Loan.Amount.ToString("C")</strong></p>
            <p>Cuotas: @Model.Loan.PaidInstallments / @Model.Loan.TotalInstallments</p>
            <p>Pendiente: <strong>@Model.Loan.PendingAmount.ToString("C")</strong></p>
            <p>Tasa de interés: @Model.Loan.AnnualInterestRate %</p>
            <p>Plazo: @Model.Loan.TermMonths meses</p>
            <p>Estado: @(Model.Loan.Status == LoanStatus.Active ? "AL DÍA" : "EN MORA")</p>

        </div>
    </div>
}
else
{
    <p class="text-danger">No tienes préstamos activos.</p>
}

<hr class="my-4" />

<h2 class="mb-4 d-flex align-items-center">
    <i class="bi bi-credit-card text-primary me-2 fs-3"></i>
    Mi Tarjeta de Crédito Activa
</h2>

@if (Model.CreditCard != null)
{
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <h5 class="card-title">Tarjeta ****@Model.CreditCard.CardNumber.Substring(Model.CreditCard.CardNumber.Length - 4)</h5>
            <p>Límite: <strong>@Model.CreditCard.CreditLimit.ToString("C")</strong></p>
            <p>Expira: @Model.CreditCard.ExpirationDate.ToString("MM/yy")</p>
            <p>Adeudado: <strong>@Model.CreditCard.Debt.ToString("C")</strong></p>
        </div>
    </div>
}
else
{
    <p class="text-danger">No tienes tarjetas de crédito activas.</p>
}
