@model WithdrawalFormViewModel
@{
    Layout = "_LayoutCashier";
    ViewData["Title"] = "Retiro";
}

<div class="container mt-5">
    <h2 class="text-danger mb-4"><i class="bi bi-cash-coin"></i> Realizar Retiro</h2>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">
            <ul>
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <li>@error.ErrorMessage</li>
                }
            </ul>
        </div>
    }

    <form asp-action="Withdrawal" method="post" class="card p-4 shadow-sm">
        <div class="mb-3">
            <label asp-for="OriginAccountNumber" class="form-label">Número de cuenta origen</label>
            <input asp-for="OriginAccountNumber" class="form-control" />
            <span asp-validation-for="OriginAccountNumber" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Amount" class="form-label">Monto a retirar</label>
            <input asp-for="Amount" class="form-control" />
            <span asp-validation-for="Amount" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-danger">
            <i class="bi bi-arrow-right-circle"></i> Continuar
        </button>
    </form>
</div>