@model ConfirmThirdPartyTransferViewModel
@{
    Layout = "_LayoutCashier";
    ViewData["Title"] = "Confirmar transferencia";
}

<h2 class="mb-4"><i class="fas fa-check-circle text-success"></i> Confirmar Transferencia</h2>

<div class="card shadow-sm">
    <div class="card-body">
        <table class="table table-bordered mb-0">
            <tr>
                <th><i class="fas fa-university"></i> Cuenta Origen</th>
                <td>@Model.OriginAccountNumber</td>
            </tr>
            <tr>
                <th><i class="fas fa-user-friends"></i> Cuenta Destino</th>
                <td>@Model.DestinationAccountNumber</td>
            </tr>
            <tr>
                <th><i class="fas fa-user"></i> Beneficiario</th>
                <td>@Model.DestinationFullName</td>
            </tr>
            <tr>
                <th><i class="fas fa-dollar-sign"></i> Monto</th>
                <td>@Model.Amount.ToString("C")</td>
            </tr>
            <tr>
                <th><i class="fas fa-clock"></i> Fecha</th>
                <td>@Model.Timestamp.ToString("f")</td>
            </tr>
        </table>
    </div>
</div>

<div class="mt-4 d-flex justify-content-end gap-2">
    <form asp-action="ConfirmTransfer" method="post">
        <button type="submit" class="btn btn-success">
            <i class="fas fa-check"></i> Confirmar
        </button>
    </form>

    <form asp-action="CancelTransfer" method="post">
        <button type="submit" class="btn btn-secondary">
            <i class="fas fa-times"></i> Cancelar
        </button>
    </form>
</div>