@model DepositConfirmationViewModel
@{
    Layout = "_LayoutCashier";
    ViewData["Title"] = "Confirmar Depósito";
}

<div class="container mt-5">
    <h2 class="text-success mb-4"><i class="bi bi-check-circle"></i> Confirmar Depósito</h2>

    <div class="card p-4 shadow-sm">
        <p><strong>Cuenta destino:</strong> @Model.DestinationAccountNumber</p>
        <p><strong>Titular:</strong> @Model.DestinationOwnerFullName</p>
        <p><strong>Monto:</strong> @Model.Amount.ToString("C", new System.Globalization.CultureInfo("es-DO"))</p>

        <form asp-action="ConfirmDeposit" method="post">
            <input type="hidden" asp-for="DestinationAccountNumber" />
            <input type="hidden" asp-for="Amount" />

            <button type="submit" class="btn btn-success me-2">
                <i class="bi bi-check-lg"></i> Confirmar
            </button>
            <a asp-action="Deposit" class="btn btn-outline-secondary">
                <i class="bi bi-x-circle"></i> Cancelar
            </a>
        </form>
    </div>
</div>