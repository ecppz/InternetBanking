@model ThirdPartyTransferViewModel
@{
    Layout = "_LayoutCashier";
    ViewData["Title"] = "Transferencia a terceros";
}

<h2 class="mb-4"><i class="fas fa-exchange-alt"></i> Transferencia a cuentas de terceros</h2>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger">
        <i class="fas fa-exclamation-triangle"></i> @Model.ErrorMessage
    </div>
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        <i class="fas fa-times-circle"></i> @TempData["ErrorMessage"]
    </div>
}

<div class="card shadow-sm mt-3">
    <div class="card-body">
        <form asp-action="TransferToThirdParty" method="post">
            <div class="mb-3">
                <label asp-for="OriginAccountNumber" class="form-label">
                    <i class="fas fa-university"></i> Cuenta Origen
                </label>
                <input asp-for="OriginAccountNumber" class="form-control" placeholder="Ej: 1234567890" />
                <span asp-validation-for="OriginAccountNumber" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Amount" class="form-label">
                    <i class="fas fa-dollar-sign"></i> Monto
                </label>
                <input asp-for="Amount" class="form-control" type="number" step="0.01" placeholder="Ej: 500.00" />
                <span asp-validation-for="Amount" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="DestinationAccountNumber" class="form-label">
                    <i class="fas fa-user-friends"></i> Cuenta Destino
                </label>
                <input asp-for="DestinationAccountNumber" class="form-control" placeholder="Ej: 0987654321" />
                <span asp-validation-for="DestinationAccountNumber" class="text-danger"></span>
            </div>

            <div class="d-flex justify-content-end mt-4">
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-arrow-right"></i> Continuar
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    @using System.Text.Json

@if (TempData["SuccessMessage"] != null)
    {
        <script>
            Swal.fire({
                icon: 'success',
                title: 'Transferencia exitosa',
                text: @Html.Raw(JsonSerializer.Serialize(TempData["SuccessMessage"])),
                confirmButtonColor: '#198754'
            });
        </script>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <script>
            Swal.fire({
                icon: 'error',
                title: 'Error en transferencia',
                text: @Html.Raw(JsonSerializer.Serialize(TempData["ErrorMessage"])),
                confirmButtonColor: '#d33'
            });
        </script>
    }
}