@model WithdrawalConfirmationViewModel
@{
    Layout = "_LayoutCashier";
    ViewData["Title"] = "Confirmar Retiro";
}

<div class="container mt-5">
    <h2 class="text-danger mb-4"><i class="bi bi-exclamation-circle"></i> Confirmar Retiro</h2>

    <div class="card p-4 shadow-sm">
        <p><strong>Cuenta origen:</strong> @Model.OriginAccountNumber</p>
        <p><strong>Titular:</strong> @Model.OriginOwnerFullName</p>
        <p><strong>Monto:</strong> @Model.Amount.ToString("C", new System.Globalization.CultureInfo("es-DO"))</p>

        <form asp-action="ConfirmWithdrawal" method="post">
            <input type="hidden" asp-for="OriginAccountNumber" />
            <input type="hidden" asp-for="Amount" />

            <button type="submit" class="btn btn-danger me-2">
                <i class="bi bi-check-lg"></i> Confirmar
            </button>
            <a asp-action="Withdrawal" class="btn btn-outline-secondary">
                <i class="bi bi-x-circle"></i> Cancelar
            </a>
        </form>
    </div>
</div>