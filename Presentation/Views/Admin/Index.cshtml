@model AdminHomeViewModel
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Panel de Control";
}
<link rel="stylesheet" href="~/styles/views/admin-home.css" asp-append-version="true" />

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark m-0">Dashboard Administrativo</h2>
            <p class="text-muted">Resumen global de operaciones del banco</p>
        </div>
        <button class="btn btn-primary btn-sm px-3 rounded-pill">
            <i class="ph-bold ph-file-pdf me-1"></i> Reporte Global
        </button>
    </div>

    <!-- Primera Fila: Transacciones y Usuarios -->
    <div class="row g-4 mb-4">
        <div class="col-md-3">
            <div class="admin-card shadow-sm">
                <div class="icon-box bg-soft-success"><i class="ph-bold ph-arrows-left-right"></i></div>
                <span class="stat-label">Transacciones</span>
                <h3 class="stat-value">@Model.TotalTransactions</h3>
                <span class="stat-sub">Hoy: <strong>@Model.TodayTransactions</strong></span>
            </div>
        </div>

        <div class="col-md-3">
            <div class="admin-card shadow-sm">
                <div class="icon-box bg-soft-info"><i class="ph-bold ph-receipt"></i></div>
                <span class="stat-label">Pagos Realizados</span>
                <h3 class="stat-value">@Model.TotalPayments</h3>
                <span class="stat-sub">Hoy: <strong>@Model.TodayPayments</strong></span>
            </div>
        </div>

        <div class="col-md-3">
            <div class="admin-card shadow-sm">
                <div class="icon-box bg-soft-primary"><i class="ph-bold ph-users-three"></i></div>
                <span class="stat-label">Clientes Activos</span>
                <h3 class="stat-value">@Model.ActiveClients</h3>
                <span class="stat-sub text-danger">Inactivos: @Model.InactiveClients</span>
            </div>
        </div>

        <div class="col-md-3">
            <div class="admin-card shadow-sm">
                <div class="icon-box bg-soft-warning"><i class="ph-bold ph-piggy-bank"></i></div>
                <span class="stat-label">Cuentas de Ahorro</span>
                <h3 class="stat-value">@Model.TotalSavingsAccounts</h3>
                <span class="stat-sub">Cartera total activa</span>
            </div>
        </div>
    </div>

    <!-- Segunda Fila: Riesgos y Productos -->
    <div class="row g-4">
        <div class="col-md-4">
            <div class="admin-card shadow-sm border-start border-danger border-4">
                <div class="d-flex align-items-center mb-3">
                    <i class="ph-bold ph-warning-circle text-danger fs-4 me-2"></i>
                    <h5 class="fw-bold m-0">Análisis de Deuda</h5>
                </div>
                <p class="stat-label mb-1">Deuda Promedio por Cliente</p>
                <h2 class="text-danger fw-800">@Model.AverageDebtPerClient</h2>
                <div class="progress mt-3" style="height: 6px;">
                    <div class="progress-bar bg-danger" style="width: 70%"></div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="admin-card shadow-sm">
                <div class="d-flex align-items-center mb-3">
                    <i class="ph-bold ph-briefcase text-primary fs-4 me-2"></i>
                    <h5 class="fw-bold m-0">Productos Activos</h5>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span>Préstamos</span>
                    <span class="badge bg-soft-danger rounded-pill">@Model.ActiveLoans</span>
                </div>
                <div class="d-flex justify-content-between">
                    <span>Tarjetas de Crédito</span>
                    <span class="badge bg-soft-primary rounded-pill">@Model.ActiveCreditCards</span>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="admin-card shadow-sm bg-dark text-white">
                <h5 class="fw-bold mb-3"><i class="ph-bold ph-shield-check me-2 text-warning"></i>Estado del Sistema</h5>
                <p class="small text-white-50">Todos los servicios están operando con normalidad. Última sincronización: @DateTime.Now.ToShortTimeString()</p>
                <div class="d-flex align-items-center mt-3">
                    <div class="spinner-grow spinner-grow-sm text-success me-2"></div>
                    <span class="small fw-bold text-success">ONLINE</span>
                </div>
            </div>
        </div>
    </div>
</div>