@model string

@{
    ViewData["Title"] = "Confirmación de cuenta";
    Layout = "_LayoutAnonymous";
    bool isSuccess = Model?.ToLower().Contains("confirmada") ?? false;
}

<div class="d-flex justify-content-center mt-5">
    <div class="col-12 col-md-6">
        <div class="card shadow-sm">
            <div class="card-header @(isSuccess ? "bg-success" : "bg-danger") text-white">
                <h5 class="text-center">
                    @(isSuccess ? "Cuenta confirmada" : "Error al confirmar")
                </h5>
            </div>
            <div class="card-body text-center">
                <div class="alert alert-primary alert-dismissible fade show" role="alert">
                    <p class="fs-5">@Model</p>
                    <a class="btn btn-outline-primary mt-3" asp-controller="Login" asp-action="Index">
                        <i class="bi bi-box-arrow-in-right"></i> Ir al login
                    </a>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
                </div>
            </div>
        </div>
    </div>
</div>