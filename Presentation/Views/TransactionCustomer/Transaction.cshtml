@{
    Layout = "_LayoutCustomer";
    ViewData["Title"] = "Menú de Transacciones";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">

<div class="container mt-5">
    <div class="row row-cols-1 row-cols-md-2 g-4">

        <!-- Transacción Express -->
        <div class="col">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body d-flex align-items-center">
                    <i class="bi bi-lightning-charge text-warning fs-3 me-3"></i>
                    <div>
                        <h5 class="card-title">Transacción Express</h5>
                        <p class="card-text">Transferencia rápida entre cuentas propias.</p>
                        <a asp-action="Express" asp-controller="TransactionCustomer" class="btn btn-outline-primary btn-sm">
                            Ir a Express
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Transacción a Beneficiarios -->
        <div class="col">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body d-flex align-items-center">
                    <i class="bi bi-people-fill text-success fs-3 me-3"></i>
                    <div>
                        <h5 class="card-title">Transferencia a Beneficiarios</h5>
                        <p class="card-text">Envía dinero a cuentas registradas como beneficiarios.</p>
                        <a asp-action="BeneficiaryTransfer" asp-controller="TransactionCustomer" class="btn btn-outline-primary btn-sm">
                            Ir a Beneficiarios
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Historial de Transacciones -->
        <div class="col">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body d-flex align-items-center">
                    <i class="bi bi-clock-history text-secondary fs-3 me-3"></i>
                    <div>
                        <h5 class="card-title">Historial de Transacciones</h5>
                        <p class="card-text">Consulta tus movimientos y operaciones realizadas.</p>
                        <a asp-action="CustomerTransactionHistory" asp-controller="Transaction" class="btn btn-outline-primary btn-sm">
                            Ver Historial
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tarjeta de Crédito (Pendiente) -->
        <div class="col">
            <div class="card h-100 shadow-sm border-0 border-dashed">
                <div class="card-body d-flex align-items-center">
                    <i class="bi bi-credit-card-2-front text-danger fs-3 me-3"></i>
                    <div>
                        <h5 class="card-title">Pago a Tarjeta de Crédito</h5>
                        <p class="card-text text-muted">
                            Realiza pagos a tus tarjetas de crédito activas, reduciendo tu deuda y manteniendo tus finanzas al día.
                        </p>
                        <a asp-action="CreditCardPaymentTransaction" asp-controller="TransactionCustomer" class="btn btn-outline-primary btn-sm">
                            Ir a pagos de tarjeta
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Préstamo (Pendiente) -->
        <div class="col">
            <div class="card h-100 shadow-sm border-0 border-dashed">
                <div class="card-body d-flex align-items-center">
                    <i class="bi bi-cash-stack text-info fs-3 me-3"></i>
                    <div>
                        <h5 class="card-title">Pago a Préstamo</h5>
                        <p class="card-text text-muted">
                            Abona a tus préstamos activos de manera sencilla, aplicando pagos a las cuotas pendientes según la amortización.
                        </p>
                        <a asp-action="LoanPaymentTransaction" asp-controller="TransactionCustomer" class="btn btn-outline-primary btn-sm">
                            Ir a pagos de prestamo
                        </a>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>